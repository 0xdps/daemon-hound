---
interface Props {
  lang?: string;
  code: string;
  copy?: string;
}

const { lang, code, copy } = Astro.props;
const copyText = copy || code;

// Normalize: replace literal \n with actual newlines
const displayCode = code.replace(/\\n/g, '\n');
const rawCopy = copyText.replace(/\\n/g, '\n');
---

<div class="code-block">
  <div class="code-block-header">
    <span>{lang || 'Shell'}</span>
    <button data-copy={rawCopy}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
      Copy
    </button>
  </div>
  <pre><code>{displayCode}</code></pre>
</div>
