# GoReleaser Dockerfile - uses pre-built binary from GoReleaser build context
FROM alpine:latest

RUN apk add --no-cache git ca-certificates

COPY dhd /usr/local/bin/dhd
RUN chmod +x /usr/local/bin/dhd

# Create a non-root user for running dhd
RUN adduser -D -s /bin/sh dhuser

# Set up volumes for config and working directory
VOLUME ["/home/dhuser/.daemon-hound", "/work"]
WORKDIR /work

USER dhuser

ENTRYPOINT ["dhd"]
CMD ["--help"]
